# База данных (пилот — SQLite-файл; для продакшена можно перейти на PostgreSQL)
DATABASE_URL="file:./dev.db"
# Секрет для подписи сессий — замените на длинную случайную строку
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Тестовый режим: быстрый вход под демо-пользователями и тестовое подключение Lichess без OAuth
TEST_MODE="true"
# Публичный адрес приложения (нужен для OAuth-редиректа Lichess)
APP_URL="http://localhost:3000"
# Идентификатор клиента для Lichess OAuth (регистрация не нужна, любое имя)
LICHESS_CLIENT_ID="bon-chess-school"
